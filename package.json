{
  "name": "strata-vid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based video editor for stitching run videos with GPX data",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=2048' jest --config jest.unit.config.js --runInBand",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=2048' jest --config jest.integration.config.js --runInBand",
    "test:visual": "strata-visual",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=2048' jest --config jest.unit.config.js --coverage --runInBand",
    "test:watch": "jest --config jest.unit.config.js --watch --runInBand",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@types/geojson": "^7946.0.16",
    "@we-gold/gpxjs": "^1.2.1",
    "clsx": "^2.1.1",
    "immer": "^11.2.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.1",
    "strata-react": "^1.0.11",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@fontsource-variable/overpass": "^5.3.0",
    "@fontsource-variable/overpass-mono": "^5.3.0",
    "@jest/globals": "^30.5.2",
    "@napi-rs/canvas": "^1.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^31.0.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.32",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "worker-timers": "^8.0.34",
    "xmldom-qsa": "^1.1.3"
  }
}
